{
  "name": "poker-dealer-sim",
  "productName": "德州扑克模拟器 Poker Simulator",
  "version": "1.0.0",
  "private": true,
  "description": "每个座位都是一个独立大语言模型的德州扑克:你当荷官看 AI 打,或者自己上桌打。第一视角 · 独立 AI 代理 · 思考过程可看 · 手机可玩",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --devtools",

    "web:build": "node tools/buildweb.mjs",
    "web:serve": "node tools/webserve.mjs 5173",
    "worker:build": "node tools/buildworker.mjs",
    "worker:dev": "cd worker/dist && npx wrangler dev",
    "worker:deploy": "cd worker/dist && npx wrangler deploy"
  },
  "devDependencies": {
    "electron": "^33.4.11"
  }
}
