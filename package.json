{
  "name": "poker-dealer-sim",
  "productName": "桌游模拟器 Tabletop Simulator",
  "version": "1.0.0",
  "private": true,
  "description": "桌游模拟器:每个座位都是一个独立大语言模型。当前能玩德州扑克(你当荷官看 AI 打,或者自己上桌打),狼人杀与谁是卧底在规划中。第一视角 3D · 独立 AI 代理 · 思考过程可看 · 手机可玩",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --devtools",
    "web:build": "node tools/buildweb.mjs",
    "web:serve": "node tools/webserve.mjs 5173",
    "worker:build": "node tools/buildworker.mjs",
    "worker:dev": "cd worker/dist && npx wrangler dev",
    "worker:deploy": "cd worker/dist && npx wrangler deploy",
    "deploy": "wrangler deploy",
    "preview": "wrangler dev"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "wrangler": "^4.150.0"
  }
}
