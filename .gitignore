# API Key 等本地机密 —— 绝不入库
# (用户自带的 Key 只应存在于本文件 / 浏览器 localStorage)
.local-secrets.json
secrets.json
.env
.env.*

# 依赖与构建产物
node_modules/
web/dist/
worker/dist/

# 运行时产物
zz-*.log
*.tmp

# 截图(体积大,不是运行所需;本地想看自己截)
shots/

# ---------------------------------------------------------------
# 测试 / 审查 / 诊断脚本不入库(体积大、只对开发有用)
#
# 保留两类:
#   1) 「运行与发布」需要的:
#        buildweb.mjs     构建浏览器版到 web/dist
#        buildworker.mjs  构建 Cloudflare Worker 到 worker/dist
#        webserve.mjs     本地起一个静态服务器预览浏览器版
#   2) 「素材流水线」—— 立绘是生成出来的,没有这两个脚本别人拿到仓库
#      没法复现(SOURCES.md / MANUAL-SOURCES.md 里也引用了它们):
#        fetchportraits.mjs       从 crosspet 取 6 套立绘
#        prepmanualportraits.mjs  处理手工素材(白底抠图 → WebP)
#        _webpsize.mjs            fetchportraits 依赖它读 WebP 尺寸
#        prepdecor.mjs            后墙挂画:assets/Background → assets/decor/painting.jpg
#   3) 防回归、且无需 Key 就能跑的:
#        relaycompat.mjs          中转站各家模型的参数兼容(假中转站,走真实调用路径)
#        navflow.mjs              主页 / 设置页 / 模型面板之间的导航
#
# 其余(audit_* / *test* / *check* / 各种 sweep、diag、probe)全部忽略。
# 想恢复某个脚本,在下面加一行 `!tools/xxx.mjs` 即可。
# ---------------------------------------------------------------
tools/*
!tools/buildweb.mjs
!tools/buildworker.mjs
!tools/webserve.mjs
!tools/fetchportraits.mjs
!tools/prepmanualportraits.mjs
!tools/_webpsize.mjs
!tools/prepdecor.mjs
!tools/relaycompat.mjs
!tools/navflow.mjs

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
!.env.example
